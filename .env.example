# ===========================================
# admin-es — Panel Administración España
# ===========================================

# Puerto servidor
PORT=4001

# Entorno
NODE_ENV=production

# Base de datos (postgres local o compartida)
DATABASE_URL=postgresql://admin_es:AdminES2024@localhost:5432/admin_es

# JWT Auth
JWT_SECRET=change-me-admin-es-production

# CORS (dominios permitidos)
CORS_ORIGIN=https://admin.escrituria.es,http://localhost:5174

# Astrea IA (OpenClaw gateway)
ASTREA_GATEWAY_URL=http://host.docker.internal:18789
ASTREA_GATEWAY_TOKEN=

# Upload / Output
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
